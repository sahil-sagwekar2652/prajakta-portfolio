---
import { posts } from '../data/posts';
import Parijat from './Parijat.astro';
import Arrow from './Arrow.astro';

const featured = posts.find((p) => p.featured)!;
const rest = posts.filter((p) => !p.featured);
---

<section class="stories" id="stories">
  <span class="b b6"><Parijat variant="fallen" size={84} rotate={-100} dur="16s" drift /></span>
  <span class="b b7"><Parijat variant="bloom" size={64} rotate={20} dur="12s" drift /></span>

  <div class="section-head" data-reveal>
    <h2>My stories</h2>
    <p class="section-sub">Night climbs, ridge walks and far wilds — written down after each return. Newest first.</p>
  </div>

  <article class="featured" data-reveal>
    <a class="featured-media" href={featured.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      <img
        src={featured.image}
        alt={featured.imageAlt}
        width={featured.imageWidth}
        height={featured.imageHeight}
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="featured-body">
      <time datetime={featured.date}>{featured.displayDate}</time>
      <h3>
        <a href={featured.url} target="_blank" rel="noopener">{featured.title}</a>
      </h3>
      <p>{featured.excerpt}</p>
      <a class="read" href={featured.url} target="_blank" rel="noopener">
        Read on YatraWithPrajakta <Arrow size={14} />
      </a>
    </div>
  </article>

  <div class="card-grid">
    {
      rest.map((post, i) => (
        <article class="card" data-reveal style={`--d: ${0.08 * (i + 1)}s`}>
          <a class="card-media" href={post.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <img
              src={post.image}
              alt={post.imageAlt}
              width={post.imageWidth}
              height={post.imageHeight}
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="card-body">
            <time datetime={post.date}>{post.displayDate}</time>
            <h3>
              <a href={post.url} target="_blank" rel="noopener">{post.title}</a>
            </h3>
            <p>{post.excerpt}</p>
            <a class="read" href={post.url} target="_blank" rel="noopener">
              Read on the blog <Arrow size={13} />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .stories {
    position: relative;
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(3rem, 8vh, 5.5rem) var(--gutter);
  }
  .section-head {
    margin-bottom: clamp(2rem, 5vh, 3.2rem);
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 3.3rem);
  }
  .section-sub {
    margin-top: 0.6rem;
    color: var(--bark);
    font-size: 1.05rem;
  }

  /* featured — the latest trek, laid out like an opened journal spread */
  .featured {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--petal);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 22px 44px -26px rgb(34 59 43 / 0.3);
    margin-bottom: clamp(2.2rem, 6vh, 3.6rem);
  }
  .featured-media {
    display: block;
    min-height: 100%;
  }
  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  .featured:hover .featured-media img {
    transform: scale(1.03);
  }
  .featured-body {
    padding: clamp(1.6rem, 3.5vw, 2.6rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    justify-content: center;
  }
  time {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--bark);
  }
  .featured h3 {
    font-size: clamp(1.7rem, 3vw, 2.15rem);
    line-height: 1.18;
  }
  .featured h3 a,
  .card h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .featured h3 a:hover,
  .card h3 a:hover {
    color: var(--saffron-deep);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--saffron-deep);
    text-decoration: none;
    width: fit-content;
    min-height: 44px;
    padding: 0.3rem 0;
  }
  .read:hover,
  .read:active {
    color: var(--ink);
  }

  /* the rest — one loose editorial rhythm, not a machine grid */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.6rem, 4vw, 2.6rem);
  }
  .card {
    background: var(--petal);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 16px 34px -24px rgb(34 59 43 / 0.28);
    display: flex;
    flex-direction: column;
  }
  .card:nth-child(even) {
    transform: translateY(clamp(0rem, 4vh, 2.2rem));
  }
  .card-media {
    display: block;
    overflow: hidden;
  }
  .card-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  .card:hover .card-media img {
    transform: scale(1.04);
  }
  .card-body {
    padding: 1.3rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }
  .card h3 {
    font-size: 1.32rem;
    line-height: 1.25;
  }
  .card p {
    font-size: 0.99rem;
    flex: 1;
  }

  .b {
    position: absolute;
  }
  .b6 { top: 3%; right: -0.6rem; }
  .b7 { bottom: 12%; left: -1rem; }

  @media (max-width: 640px) {
    .stories {
      padding: clamp(2.2rem, 6vh, 4rem) var(--gutter);
    }
    .featured-body {
      padding: 1.25rem 1.15rem;
      gap: 0.65rem;
    }
    .card-body {
      padding: 1.15rem 1.1rem;
      gap: 0.5rem;
    }
    .card-grid {
      gap: 1.4rem;
    }
    .b6,
    .b7 {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured-media img {
      aspect-ratio: 16 / 10;
      height: auto;
    }
    .card-grid {
      grid-template-columns: 1fr;
    }
    .card:nth-child(even) {
      transform: none;
    }
  }
</style>
