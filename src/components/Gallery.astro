---
import { photos } from '../data/photos';
import Parijat from './Parijat.astro';
---

<section class="moments" id="moments">
  <span class="b b8"><Parijat variant="bud" size={64} rotate={-30} dur="14s" drift /></span>

  <div class="section-head" data-reveal>
    <div class="head-text">
      <h2>Moments between treks</h2>
      <p class="section-sub">From my own camera roll — drag or scroll sideways.</p>
    </div>
    <div class="gallery-controls" aria-label="Gallery controls">
      <button class="nav-btn prev" aria-label="Previous photo" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="nav-btn next" aria-label="Next photo" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="strip-wrap" data-reveal>
    <div class="strip" id="moments-strip">
      {
        photos.map((photo) => (
          <figure>
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              decoding="async"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const strip = document.getElementById('moments-strip');
  const prevBtn = document.querySelector<HTMLButtonElement>('.moments .nav-btn.prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.moments .nav-btn.next');

  if (strip) {
    const getScrollStep = () => Math.min(strip.clientWidth * 0.75, 480);

    prevBtn?.addEventListener('click', () => {
      strip.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      strip.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    // Drag-to-scroll support
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    strip.addEventListener('mousedown', (e) => {
      isDown = true;
      strip.classList.add('is-dragging');
      startX = e.pageX - strip.offsetLeft;
      scrollLeft = strip.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      strip.classList.remove('is-dragging');
    });

    strip.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - strip.offsetLeft;
      const walk = (x - startX) * 1.35;
      strip.scrollLeft = scrollLeft - walk;
    });

    strip.querySelectorAll('img').forEach((img) => {
      img.addEventListener('dragstart', (e) => e.preventDefault());
    });
  }
</script>

<style>
  .moments {
    position: relative;
    padding: clamp(3rem, 8vh, 5.5rem) 0 clamp(3.5rem, 9vh, 6rem);
    max-width: 76rem;
    margin-inline: auto;
  }
  .section-head {
    padding-inline: var(--gutter);
    margin-bottom: clamp(1.8rem, 4.5vh, 2.6rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .head-text {
    flex: 1;
    min-width: min(100%, 20rem);
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 3.3rem);
  }
  .section-sub {
    margin-top: 0.6rem;
    color: var(--bark);
    font-size: 1.05rem;
  }

  .gallery-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--petal);
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 4px 12px -4px rgb(34 59 43 / 0.15);
    transition: all 0.2s var(--ease-out);
  }
  .nav-btn:hover {
    color: var(--saffron-deep);
    border-color: var(--saffron);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px -4px rgb(34 59 43 / 0.25);
  }
  .nav-btn:active {
    transform: translateY(0);
  }

  .strip-wrap {
    position: relative;
  }

  .strip {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.4rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--gutter);
    padding: 0.4rem var(--gutter) 1.2rem;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 3%, #000 97%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 3%, #000 97%, transparent 100%);
    cursor: grab;
    user-select: none;
    scrollbar-width: thin;
  }
  .strip.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  .strip::after {
    content: '';
    flex: 0 0 var(--gutter);
  }

  .strip figure {
    margin: 0;
    flex: none;
    scroll-snap-align: start;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 36px -22px rgb(34 59 43 / 0.35);
  }
  .strip img {
    height: clamp(16rem, 52vh, 26rem);
    width: auto;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }
  .strip figcaption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.2rem 1.1rem 0.8rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--petal);
    background: linear-gradient(transparent, rgb(20 36 26 / 0.72));
  }

  .b {
    position: absolute;
  }
  .b8 { top: 6%; right: 4%; }

  @media (max-width: 640px) {
    .strip img {
      height: clamp(13rem, 44vh, 18rem);
    }
    .b8 {
      display: none;
    }
    .gallery-controls {
      display: none;
    }
  }
</style>
