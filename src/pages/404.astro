---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Parijat from '../components/Parijat.astro';
import Arrow from '../components/Arrow.astro';
---

<Base
  title="Page not found — Prajakta Patil"
  description="This trail doesn't lead anywhere. Return to Prajakta Patil's personal home."
>
  <Nav />
  <main class="not-found">
    <div class="content" data-settle>
      <span class="blossom">
        <Parijat variant="fallen" size={96} rotate={-25} />
      </span>
      <p class="code">404</p>
      <h1>The trail ends here</h1>
      <p class="lead">
        Looks like this path wandered off into the mist. The page you were looking for doesn't exist or has moved.
      </p>
      <div class="actions">
        <a class="primary" href="/">Return to the trail <Arrow direction="e" size={14} /></a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .not-found {
    min-height: calc(100svh - 14rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(3rem, 10vh, 6rem) var(--gutter);
    text-align: center;
  }
  .content {
    max-width: 38rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .blossom {
    margin-bottom: 1.5rem;
  }
  .code {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--saffron-deep);
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-top: 0.4rem;
  }
  .lead {
    margin-top: 1.1rem;
    font-size: 1.18rem;
    color: var(--bark);
    max-width: 42ch;
  }
  .actions {
    margin-top: 2.2rem;
  }
  .primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--petal);
    background: var(--saffron-deep);
    padding: 0.75rem 1.8rem;
    min-height: 48px;
    border-radius: 9999px;
    text-decoration: none;
    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);
    box-shadow: 0 10px 24px -10px rgb(168 81 14 / 0.5);
  }
  .primary:hover,
  .primary:active {
    background: var(--ink);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .not-found {
      padding: clamp(2rem, 6vh, 4rem) var(--gutter);
    }
    .actions {
      width: 100%;
    }
    .primary {
      width: 100%;
    }
  }
</style>
