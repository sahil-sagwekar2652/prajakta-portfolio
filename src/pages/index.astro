---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stories from '../components/Stories.astro';
import Gallery from '../components/Gallery.astro';
import Venture from '../components/Venture.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Prajakta Patil — trekker, writer, founder"
  description="Prajakta Patil: athlete, trekker, poet, traveller, tour guide and writer. Stories from the Sahyadris and beyond — and founder of Muhurta Yatra, journeys at the auspicious time."
>
  <Nav />
  <main>
    <Hero />
    <Stories />
    <Gallery />
    <Venture />
  </main>
  <Footer />
</Base>
